# ---------------------------------------------------------------------------
# MarketPulse AI — environment configuration
# Copy to .env (never commit .env). Values below are safe development defaults.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Postgres in Docker Compose; sqlite fallback for bare-metal local dev.
DATABASE_URL=postgresql+psycopg://marketpulse:marketpulse@postgres:5432/marketpulse
# DATABASE_URL=sqlite:///./marketpulse.db

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# --- Demonstration mode -----------------------------------------------------
# When true the app seeds one clearly-labelled synthetic research project.
# Demo findings never claim to come from live web research.
DEMO_MODE=true
SEED_DEMO_ON_STARTUP=true

# --- Search provider (required for LIVE research) ---------------------------
# none | tavily | brave
SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- LLM provider (optional; enables live reasoning for LIVE research) ------
# gemini | none
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# --- Background jobs --------------------------------------------------------
# inline  -> thread pool inside the API process (no Redis required)
# celery  -> Redis + Celery worker (used by docker compose)
JOB_RUNNER=inline
REDIS_URL=redis://redis:6379/0

# --- Limits / reliability ---------------------------------------------------
RATE_LIMIT_AI_PER_HOUR=60
SEARCH_TIMEOUT_SECONDS=25
LLM_TIMEOUT_SECONDS=60
RESEARCH_MAX_QUERIES=12

# --- Frontend (Vite build-time) --------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
